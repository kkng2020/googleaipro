# Server Port & Base URL
PORT=3000
BASE_URL=https://mybrotool.vercel.app

# Payment Provider: 'buatqris' atau 'simulator'
PAYMENT_PROVIDER=buatqris

# Kredensial BuatQris Open API (ambil di app.buatqris.site menu Open API)
BQ_ACCOUNT_ID=user_xxxx
BQ_SECRET_TOKEN=sk_live_xxxx
BQ_SIGNING_SECRET=whsec_xxxx
BQ_TEST_MODE=0

# Database Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Keamanan Dashboard Admin
ADMIN_PASSWORD=change_this_secure_password
